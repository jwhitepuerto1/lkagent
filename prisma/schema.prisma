generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}


model Lead {
  id           String   @id
  name         String
  segment      String?
  stage        String?
  status       String?
  owner        String?
  priority     String?
  nextActionAt DateTime?
  lastTouch    DateTime?
  activities Activity[]
}
model Activity {
  id         String   @id @default(cuid())
  leadId     String
  type       String
  note       String?
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, occurredAt])
}

