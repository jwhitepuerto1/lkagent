generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

/**
 * Identity Kernel (IAS System-of-Record foundation)
 * - Party is the canonical identity container (person/org/unknown)
 * - ContactPoint represents reachable identifiers (email/linkedin/phone/domain)
 * - ExternalIdentity maps Party <-> external tool objects (Smartlead/Aimfox/Mautic/SuiteCRM/GlobalDB)
 */

enum PartyType {
  PERSON
  ORG
  UNKNOWN
}

enum ContactPointType {
  EMAIL
  PHONE
  LINKEDIN
  DOMAIN
  OTHER
}

enum ExternalSystem {
  GLOBALDB
  SMARTLEAD
  AIMFOX
  MAUTIC
  SUITECRM
  OTHER
}

enum ExternalObjectType {
  CONTACT
  LEAD
  ACCOUNT
  CAMPAIGN_MEMBER
  OTHER
}

model Party {
  id          String    @id @default(uuid())
  type        PartyType @default(UNKNOWN)
  displayName String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // relations
  contactPoints      ContactPoint[]
  externalIdentities ExternalIdentity[]

  // optional 1:1 bridge from legacy Lead -> Party
  lead Lead?

  // member identity system
  memberAccount MemberAccount?
  entitlements  Entitlement[]
}

model ContactPoint {
  id              String           @id @default(uuid())
  partyId         String
  type            ContactPointType
  valueRaw        String?
  valueNormalized String
  isPrimary       Boolean          @default(false)
  isVerified      Boolean          @default(false)
  source          String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([partyId])
  @@index([type, valueNormalized])
}

model ExternalIdentity {
  id         String             @id @default(uuid())
  partyId    String
  system     ExternalSystem
  objectType ExternalObjectType @default(CONTACT)
  externalId String
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)

  // Hard requirements to prevent identity fragmentation across tools
  @@unique([system, externalId])
  @@unique([system, partyId, objectType])
  @@index([partyId])
}

/**
 * Member identity system (self-service registration/login)
 * - MemberAccount is the 1:1 credential/login bridge onto Party.
 * - Entitlement is a per-module access grant, so future modules can require
 * staff approval (PENDING) without changing this shape.
 */
enum MemberStatus {
  ACTIVE
  DISABLED
}

enum EntitlementModule {
  RESOURCES
  CAPITAL_RAISE
  DATA_ROOM
  INVESTMENT_ACCOUNT
}

enum EntitlementStatus {
  GRANTED
  PENDING
  DENIED
  REVOKED
}

model MemberAccount {
  id           String       @id @default(uuid())
  partyId      String       @unique
  firstName    String
  lastName     String
  email        String       @unique
  passwordHash String
  status       MemberStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)
}

model Entitlement {
  id          String            @id @default(uuid())
  partyId     String
  module      EntitlementModule
  status      EntitlementStatus @default(GRANTED)
  requestedAt DateTime          @default(now())
  grantedAt   DateTime?
  grantedBy   String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@unique([partyId, module])
  @@index([partyId])
}

/**
 * Legacy v2 models (keep working)
 * - Lead remains your UI projection + current CRUD entity.
 * - partyId is added as an OPTIONAL bridge, so nothing breaks until you backfill + start writing it.
 */
model Lead {
  id           String    @id
  name         String
  segment      String?
  stage        String?
  status       String?
  owner        String?
  priority     String?
  nextActionAt DateTime?
  lastTouch    DateTime?

  // NEW: Optional bridge into canonical identity
  partyId String? @unique
  party   Party?  @relation(fields: [partyId], references: [id], onDelete: SetNull)

  activities Activity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Activity {
  id         String   @id @default(cuid())
  leadId     String
  type       String
  note       String?
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, occurredAt])
}

/**
 * LinkedIn Post Generation + Publishing Agent (Phase 1)
 * - Generation Agent: LinkedinDestination/InsightTopic/EducationalAsset catalogs feed
 * ContentCampaign -> CampaignTheme -> GeneratedPost, gated by approval + validation.
 * - Publishing Agent: PublishingJob is the literal handoff table (spec section 14
 * contract) created only from approved+locked GeneratedPost rows. Phase 1 publishing
 * is fully supervised (no live LinkedIn API calls) - PublishedPost records a manually
 * entered proof URL rather than automated confirmation.
 */

enum LinkedinDestinationType {
  PERSONAL
  COMPANY
  GROUP
}

enum LinkedinDestinationStatus {
  ACTIVE
  PAUSED
  BLOCKED
  LEFT
}

enum PublishingMode {
  SUPERVISED
  AUTOMATIC
}

enum PostType {
  INSIGHT
  ASSET
}

enum TopicSelectionMode {
  AUTOMATIC
  SPECIFIED
}

enum AssetSelectionMode {
  AUTOMATIC
  SPECIFIED
}

// Shared lifecycle for ContentCampaign.status and CampaignTheme.status.
enum ContentLifecycleStatus {
  DRAFT
  GENERATING
  VALIDATION_FAILED
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  READY_TO_PUBLISH
  SUSPENDED
}

enum ValidationStatus {
  PENDING
  PASSED
  FAILED
}

// Per-GeneratedPost approval state. LOCKED is the literal
// "generated_post.approval_status=locked" the handoff contract checks.
enum ApprovalStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  LOCKED
}

enum ApprovalLevel {
  PLACEMENT
  THEME
  CAMPAIGN
}

enum ApprovalAction {
  APPROVE
  REQUEST_CHANGES
  LOCK
}

enum ValidationCheckCode {
  REQUIRED_FIELDS
  SOURCE_ACTIVE
  DESTINATION_ACTIVE
  URL_SYNTAX
  CHAR_LIMIT
  URL_PLACEMENT
  DUPLICATE_CONTENT
  SIMILARITY
  DESTINATION_VOICE
  CTA_MATCH
  VARIANT_COUNT
}

enum ValidationFailureReason {
  INVALID_CAMPAIGN_LENGTH
  COUNT_MISMATCH
  INVALID_GROUP_COUNT
  INSUFFICIENT_TOPICS
  INSUFFICIENT_ASSETS
  ASSET_COPY_MISSING
  URL_INVALID
  SOURCE_CONFLICT
  UNSUPPORTED_CLAIM
  DUPLICATE_CONTENT
  HIGH_SIMILARITY
  DESTINATION_RULE_FAILURE
  GENERATION_INCOMPLETE
  APPROVAL_HASH_MISMATCH
  DATABASE_WRITE_FAILURE
}

enum GenerationRunType {
  OUTLINE
  COPY
}

enum GenerationRunStatus {
  SUCCESS
  FAILED
}

// Full spec state model. Phase 1's supervised UI only exercises a subset;
// PUBLISHING/VERIFYING/RETRY_READY are reserved for a future live-API phase.
enum PublishingJobStatus {
  DRAFT
  APPROVED
  QUEUED
  PRECHECK
  AWAITING_HUMAN
  PUBLISHING
  VERIFYING
  PENDING_GROUP_REVIEW
  PUBLISHED
  RETRY_READY
  BLOCKED
  FAILED
  SKIPPED
  CANCELLED
}

enum PublicationAttemptAction {
  PRECHECK
  CONFIRM
  BLOCK
  SKIP
  CANCEL
  MARK_PENDING_REVIEW
}

enum PublicationAttemptResult {
  OK
  FAILED
}

enum ModerationStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

model LinkedinDestination {
  id                      String                    @id @default(uuid())
  destinationType         LinkedinDestinationType
  name                    String
  linkedinReference       String?
  status                  LinkedinDestinationStatus @default(ACTIVE)
  audienceDescription     String?
  rulesSummary            String?
  promotionalLinksAllowed Boolean                   @default(true)
  requiresModeratorReview Boolean                   @default(false)
  preferredDaysTimes      String?
  postingFrequencyCeiling Int?
  lastSuccessfulPostAt    DateTime?
  urlPlacementPolicy      String                    @default("end")
  templateNotes           String?
  publishingMode          PublishingMode            @default(SUPERVISED)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  campaignsAsPersonal ContentCampaign[]      @relation("CampaignPersonalDestination")
  campaignsAsCompany  ContentCampaign[]      @relation("CampaignCompanyDestination")
  campaignGroupLinks  ContentCampaignGroup[]
  generatedPosts      GeneratedPost[]
  publishingJobs      PublishingJob[]
  publishedPosts      PublishedPost[]

  @@index([destinationType, status])
}

model InsightTopic {
  id               String    @id @default(uuid())
  name             String
  description      String
  approvedAngles   Json
  prohibitedAngles Json
  targetAudiences  Json
  supportingFacts  Json
  preferredCtaType String?
  lastUsedAt       DateTime?
  active           Boolean   @default(true)
  version          Int       @default(1)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  themes CampaignTheme[]

  @@index([active])
}

model EducationalAsset {
  id               String    @id @default(uuid())
  assetName        String
  assetType        String
  canonicalUrl     String
  sourceCopy       String
  shortSummary     String
  learningOutcomes Json
  targetAudiences  Json
  primaryProblem   String
  approvedCta      String
  gatingType       String    @default("none")
  urlStatus        String    @default("unchecked")
  lastUrlCheckAt   DateTime?
  lastUsedAt       DateTime?
  active           Boolean   @default(true)
  version          Int       @default(1)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  themes CampaignTheme[]

  @@index([active])
}

model ContentCampaign {
  id                             String                 @id @default(uuid())
  campaignName                   String
  campaignDays                   Int
  startDate                      DateTime
  timezone                       String
  insightPostCount               Int
  assetPostCount                 Int
  personalDestinationId          String
  companyDestinationId           String
  topicSelectionMode             TopicSelectionMode     @default(AUTOMATIC)
  topicSelectionConfig           Json?
  assetSelectionMode             AssetSelectionMode     @default(AUTOMATIC)
  assetSelectionConfig           Json?
  styleTone                      String
  stylePostLength                String
  styleCtaStrength               String
  styleUseHashtags               Boolean                @default(true)
  styleMaxHashtags               Int                    @default(3)
  styleIncludeQuestion           Boolean                @default(true)
  styleGroupPersonalizationLevel String                 @default("individual_group")
  status                         ContentLifecycleStatus @default(DRAFT)
  suspended                      Boolean                @default(false)
  createdBy                      String                 @default("admin")
  createdAt                      DateTime               @default(now())
  updatedAt                      DateTime               @updatedAt

  personalDestination LinkedinDestination       @relation("CampaignPersonalDestination", fields: [personalDestinationId], references: [id])
  companyDestination  LinkedinDestination       @relation("CampaignCompanyDestination", fields: [companyDestinationId], references: [id])
  groupDestinations   ContentCampaignGroup[]
  themes              CampaignTheme[]
  generatedPosts      GeneratedPost[]
  generationRuns      PostGenerationRun[]
  approvals           ContentApproval[]
  validationResults   ContentValidationResult[]
  publishingJobs      PublishingJob[]

  @@index([status])
}

model ContentCampaignGroup {
  id            String   @id @default(uuid())
  campaignId    String
  destinationId String
  createdAt     DateTime @default(now())

  campaign    ContentCampaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  destination LinkedinDestination @relation(fields: [destinationId], references: [id])

  @@unique([campaignId, destinationId])
  @@index([campaignId])
}

model CampaignTheme {
  id              String                 @id @default(uuid())
  campaignId      String
  dayIndex        Int
  postDate        DateTime
  postType        PostType
  topicId         String?
  assetId         String?
  audienceSummary String?
  centralPoint    String
  hookConcept     String
  ctaConcept      String
  status          ContentLifecycleStatus @default(DRAFT)
  suspended       Boolean                @default(false)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  campaign          ContentCampaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  topic             InsightTopic?             @relation(fields: [topicId], references: [id])
  asset             EducationalAsset?         @relation(fields: [assetId], references: [id])
  generatedPosts    GeneratedPost[]
  generationRuns    PostGenerationRun[]
  approvals         ContentApproval[]
  validationResults ContentValidationResult[]
  publishingJobs    PublishingJob[]

  @@unique([campaignId, dayIndex])
  @@index([campaignId, status])
}

model GeneratedPost {
  id                String           @id @default(uuid())
  campaignId        String
  themeId           String
  destinationId     String
  postType          PostType
  postText          String
  contentHash       String
  lockedContentHash String?
  copyVersion       Int              @default(1)
  urlIncluded       String?
  hashtags          Json?
  validationStatus  ValidationStatus @default(PENDING)
  approvalStatus    ApprovalStatus   @default(DRAFT)
  approvedBy        String?
  approvedAt        DateTime?
  suspended         Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  campaign          ContentCampaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  theme             CampaignTheme             @relation(fields: [themeId], references: [id], onDelete: Cascade)
  destination       LinkedinDestination       @relation(fields: [destinationId], references: [id])
  versions          GeneratedPostVersion[]
  approvals         ContentApproval[]
  validationResults ContentValidationResult[]
  generationRuns    PostGenerationRun[]
  publishingJob     PublishingJob?

  @@unique([themeId, destinationId])
  @@index([campaignId])
  @@index([destinationId])
}

model GeneratedPostVersion {
  id              String   @id @default(uuid())
  generatedPostId String
  copyVersion     Int
  postText        String
  contentHash     String
  changeReason    String?
  changedBy       String   @default("admin")
  createdAt       DateTime @default(now())

  generatedPost GeneratedPost @relation(fields: [generatedPostId], references: [id], onDelete: Cascade)

  @@unique([generatedPostId, copyVersion])
}

model PostGenerationRun {
  id                String              @id @default(uuid())
  campaignId        String
  themeId           String?
  generatedPostId   String?
  runType           GenerationRunType
  model             String
  promptVersion     String
  configVersion     String?
  requestSummary    Json
  responseSummary   Json?
  usageInputTokens  Int?
  usageOutputTokens Int?
  latencyMs         Int?
  status            GenerationRunStatus
  errorMessage      String?
  createdAt         DateTime            @default(now())

  campaign      ContentCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  theme         CampaignTheme?  @relation(fields: [themeId], references: [id])
  generatedPost GeneratedPost?  @relation(fields: [generatedPostId], references: [id])

  @@index([campaignId])
}

model ContentApproval {
  id              String         @id @default(uuid())
  campaignId      String
  themeId         String?
  generatedPostId String?
  level           ApprovalLevel
  action          ApprovalAction
  approver        String         @default("admin")
  copyVersion     Int?
  sourceVersion   Int?
  notes           String?
  createdAt       DateTime       @default(now())

  campaign      ContentCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  theme         CampaignTheme?  @relation(fields: [themeId], references: [id])
  generatedPost GeneratedPost?  @relation(fields: [generatedPostId], references: [id])

  @@index([campaignId])
  @@index([generatedPostId])
}

model ContentValidationResult {
  id              String                   @id @default(uuid())
  campaignId      String?
  campaignThemeId String?
  generatedPostId String?
  checkCode       ValidationCheckCode
  passed          Boolean
  reasonCode      ValidationFailureReason?
  message         String?
  details         Json?
  createdAt       DateTime                 @default(now())

  campaign      ContentCampaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  theme         CampaignTheme?   @relation(fields: [campaignThemeId], references: [id])
  generatedPost GeneratedPost?   @relation(fields: [generatedPostId], references: [id])

  @@index([generatedPostId])
  @@index([campaignThemeId])
}

// The literal handoff table (spec section 14): each row's fields map 1:1
// onto the required publishing-job JSON contract between the two agents.
model PublishingJob {
  id                  String                  @id @default(uuid())
  idempotencyKey      String                  @unique
  campaignId          String
  themeId             String
  generatedPostId     String                  @unique
  copyVersion         Int
  destinationId       String
  destinationType     LinkedinDestinationType
  linkedinReference   String?
  publishingMode      PublishingMode
  status              PublishingJobStatus     @default(QUEUED)
  publishDate         DateTime
  earliestPublishAt   DateTime
  latestPublishAt     DateTime
  timezone            String
  sequence            Int                     @default(0)
  contentTextSnapshot String
  canonicalUrl        String?
  publishedUrl        String?
  mediaAssetId        String?
  contentHash         String
  postType            PostType
  topicId             String?
  assetId             String?
  sourceVersion       Int?
  approvedBy          String?
  approvedAt          DateTime?
  confirmedBy         String?
  confirmedAt         DateTime?
  blockReason         String?
  skipReason          String?
  cancelReason        String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  campaign      ContentCampaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  theme         CampaignTheme        @relation(fields: [themeId], references: [id])
  generatedPost GeneratedPost        @relation(fields: [generatedPostId], references: [id])
  destination   LinkedinDestination  @relation(fields: [destinationId], references: [id])
  attempts      PublicationAttempt[]
  publishedPost PublishedPost?

  @@index([status])
  @@index([campaignId])
  @@index([destinationId, status])
  @@index([publishDate])
}

model PublicationAttempt {
  id              String                   @id @default(uuid())
  publishingJobId String
  attemptNumber   Int
  action          PublicationAttemptAction
  result          PublicationAttemptResult
  actor           String                   @default("admin")
  details         Json?
  createdAt       DateTime                 @default(now())

  publishingJob PublishingJob @relation(fields: [publishingJobId], references: [id], onDelete: Cascade)

  @@index([publishingJobId])
}

model PublishedPost {
  id               String           @id @default(uuid())
  publishingJobId  String           @unique
  destinationId    String
  postUrl          String
  publishedAt      DateTime         @default(now())
  recordedBy       String           @default("admin")
  moderationStatus ModerationStatus @default(NONE)
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  publishingJob PublishingJob       @relation(fields: [publishingJobId], references: [id], onDelete: Cascade)
  destination   LinkedinDestination @relation(fields: [destinationId], references: [id])
}

// Singleton row (id="global"), owned by the Publishing Agent side:
// global/category pause switches (spec section 7.11).
model PublishingControl {
  id             String   @id @default("global")
  pauseAll       Boolean  @default(false)
  pausePersonal  Boolean  @default(false)
  pauseCompany   Boolean  @default(false)
  pauseAllGroups Boolean  @default(false)
  updatedAt      DateTime @updatedAt
  updatedBy      String?
}

// Singleton row (id="global"), owned by the Generation Agent side:
// admin-editable char limit + similarity/reuse thresholds.
model PlatformConfig {
  id                    String   @id @default("global")
  linkedinCharLimit     Int      @default(3000)
  similarityThreshold   Float    @default(0.82)
  duplicateLookbackDays Int      @default(90)
  reuseCooldownDays     Int      @default(30)
  updatedAt             DateTime @updatedAt
  updatedBy             String?
}

/**
 * LinkedIn Engagement Tracking Agent (Phase 1: ingestion only)
 * - Pulls likes/comments on the connected LinkedIn account's posts via
 * Unipile and writes normalized Post/Profile/Engagement rows here.
 * - Profile rows start as stubs (URN + public URL only); full enrichment
 * (name/headline/company) is an explicitly deferred Phase 2, not built yet.
 * - Ids use uuid() rather than the spec's cuid() to match this schema's
 * existing convention for every other model.
 */
enum PostSource {
  PERSONAL
  GROUP
}

enum EngagementType {
  LIKE
  COMMENT
  REACTION_OTHER
}

model EngagementPost {
  id              String             @id @default(uuid())
  linkedinUrn     String             @unique
  source          PostSource
  // GROUP detection IS confirmed against a live Unipile payload (2026-08-09)
  // - see lib/linkedinEngagement/detectSource.js. This flag exists for the
  // general case of a confident field-based detection vs. an unverified
  // default, so a human can review ambiguous rows later if that ever arises.
  sourceConfident Boolean            @default(true)
  postedAt        DateTime
  url             String
  textSnippet     String?
  engagements     EngagementRecord[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model EngagementProfile {
  id            String    @id @default(uuid())
  linkedinUrn   String    @unique
  publicUrl     String?   @unique
  fullName      String?
  headline      String?
  companyName   String?
  companyUrl    String?
  location      String?
  connectionDeg String?
  enrichedAt    DateTime?
  raw           Json?

  // Outreach intelligence (Capital Context LinkedIn Engagement, Outreach
  // Intelligence, and CRE Prospect Promotion Agent spec, sections 7.4-7.10).
  // This one record IS the canonical person - no parallel Person/Prospect
  // model, per the spec's own "one identity, don't fragment" rule.
  primaryCategory          PersonCategory?
  secondaryCategories      Json? // PersonCategory[] as strings
  classificationConfidence Float?
  classificationEvidence   Json? // string[] of reasons
  classificationOverridden Boolean         @default(false)
  fitScore                 Int?
  engagementScore          Int?
  priorityScore            Int?
  scoreFactors             Json? // contributing factors, for explainability (spec 7.5.D)
  scoreCalculatedAt        DateTime?
  status                   PersonStatus    @default(LINKEDIN_LEAD)
  lastInboundAt            DateTime? // reply, accepted invite, comment reply
  lastOutboundAt           DateTime? // DM sent, invite sent, comment posted (manual, logged by John)
  nextActionDue            DateTime?
  nextActionReason         String?
  noResponseCount          Int             @default(0)
  suppressed               Boolean         @default(false)
  suppressedReason         String?
  promotedAt               DateTime?
  promotedBy               String?
  promotionReason          String?
  promotionExportId        String?

  engagements     EngagementRecord[]
  invites         OutreachInvite[]
  conversations   OutreachConversation[]
  commentReplies  OutreachCommentReply[]
  promotionExport PromotionExport?       @relation(fields: [promotionExportId], references: [id])
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([status])
  @@index([primaryCategory])
}

// Spec section 7.4 - 12 required categories.
enum PersonCategory {
  CRE_SPONSOR_DEVELOPER
  REAL_ESTATE_FUND_MANAGER
  REAL_ESTATE_SYNDICATOR
  CRE_OPERATOR
  CAPITAL_RAISING_ADVISOR
  SECURITIES_OR_RE_ATTORNEY
  CPA_TAX_ADVISOR
  INVESTOR_CONTACT
  CRE_SERVICE_PROVIDER
  INDUSTRY_PUBLICATION_OR_INFLUENCER
  UNRELATED_LOW_RELEVANCE
  UNCLEAR_REVIEW_REQUIRED
}

// Trimmed to the LinkedIn-side lifecycle this agent actually owns (spec
// section 9) - everything from "Selected for Enrichment" onward belongs to
// the separate ias_cre_agent module this agent hands off a CSV to.
enum PersonStatus {
  LINKEDIN_LEAD
  ENGAGEMENT_REVIEW
  CONVERSATION_ACTIVE
  FOLLOW_UP_DUE
  WATCHLIST
  PROMOTED
  IRRELEVANT
  SUPPRESSED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED_OR_WITHDRAWN
}

// Discovered via polling /users/invite/sent (spec-confirmed: this endpoint
// only lists PENDING invitations - acceptance is inferred when a
// previously-seen invite disappears from this list, then confirmed via a
// profile lookup's network_distance field, per Unipile's own documented
// "Detecting Accepted Invitations" guidance).
model OutreachInvite {
  id                  String       @id @default(uuid())
  profileId           String
  unipileInvitationId String       @unique
  invitationText      String?
  status              InviteStatus @default(PENDING)
  sentAt              DateTime?
  firstSeenAt         DateTime     @default(now())
  resolvedAt          DateTime?
  lastCheckedAt       DateTime     @default(now())

  profile EngagementProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([status])
}

// One row per Unipile chat with a first-degree connection. Direction is
// read from each message's confirmed `is_sender` field (1 = John sent it).
model OutreachConversation {
  id                 String    @id @default(uuid())
  profileId          String
  unipileChatId      String    @unique
  lastOutboundAt     DateTime?
  lastInboundAt      DateTime?
  lastMessageSnippet String?
  awaitingReply      Boolean   @default(false) // John sent the last message, no reply yet
  requiresMyResponse Boolean   @default(false) // they replied since John's last message
  lastCheckedAt      DateTime  @default(now())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  profile EngagementProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([requiresMyResponse])
}

// No Unipile endpoint discovers "posts John commented on" - John logs the
// post URL and the exact text of his own comment manually; the agent then
// polls that post's comment list for anyone else's comment appearing after
// his. This is a documented approximation, not true parent-comment
// threading, since Unipile does not expose an explicit reply-to-comment
// field for LinkedIn.
model OutreachComment {
  id             String    @id @default(uuid())
  postUrl        String
  postSocialId   String? // resolved on first successful check
  myCommentText  String
  myCommentAt    DateTime?
  postAuthorName String?
  status         String    @default("WATCHING") // WATCHING | REPLIED | NO_REPLY_YET
  loggedAt       DateTime  @default(now())
  lastCheckedAt  DateTime  @default(now())

  replies OutreachCommentReply[]
}

model OutreachCommentReply {
  id                String   @id @default(uuid())
  outreachCommentId String
  profileId         String?
  unipileCommentId  String   @unique
  replierName       String?
  replyText         String
  repliedAt         DateTime
  discoveredAt      DateTime @default(now())

  outreachComment OutreachComment    @relation(fields: [outreachCommentId], references: [id], onDelete: Cascade)
  profile         EngagementProfile? @relation(fields: [profileId], references: [id])

  @@index([outreachCommentId])
}

// One row per CSV file exported for manual hand-off into ias_cre_agent
// (C:\Users\jwhit\IAspecmodule\ias_cre_agent) - John submits the file there
// himself; this agent never talks to that module directly.
model PromotionExport {
  id          String   @id @default(uuid())
  fileName    String
  recordCount Int
  exportedBy  String   @default("admin")
  exportedAt  DateTime @default(now())

  profiles EngagementProfile[]
}

model EngagementRecord {
  id           String         @id @default(uuid())
  postId       String
  profileId    String
  type         EngagementType
  // Non-null with an empty-string default (never actual NULL) so the
  // @@unique below actually dedupes LIKE/REACTION_OTHER rows across runs -
  // Postgres treats every NULL as distinct from every other NULL, which
  // would otherwise defeat idempotency for non-comment engagement types.
  commentText  String         @default("")
  reactedAt    DateTime
  discoveredAt DateTime       @default(now())

  post    EngagementPost    @relation(fields: [postId], references: [id], onDelete: Cascade)
  profile EngagementProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([postId, profileId, type, commentText])
  @@index([postId])
  @@index([profileId])
}

model EngagementSyncRun {
  id             String    @id @default(uuid())
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  postsScanned   Int?
  newEngagements Int?
  errorMessage   String?
}
